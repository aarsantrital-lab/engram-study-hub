      "description": "Start tonight's spaced-review session",
      "url": "./#/study",
      "icons": [{ "src": "assets/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Mind maps",
      "short_name": "Maps",
      "description": "Open the map canvas",
      "url": "./#/maps",
      "icons": [{ "src": "assets/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Focus mode",
      "short_name": "Focus",
      "description": "One task, timer running, chat muted",
      "url": "./#/focus",
      "icons": [{ "src": "assets/icons/icon-192.png", "sizes": "192x192" }]
    }
  ]
